PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_BUCKET_NAME=your_r2_bucket_name
CLOUDFLARE_PUBLIC_URL=https://pub-xxxx.r2.dev

# Equivalent R2_* aliases also work:
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=your_r2_bucket_name
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev
RAPIDO_API_KEY=your_rapido_api_key
RAPIDO_BASE_URL=https://api.rapido.bike/v1
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_API_KEY=your_shiprocket_api_key_or_token
CLIENT_URL=http://localhost:3000

# Resend Email (Transactional Emails)
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=support@shopchipzo.com

# WhatsApp Notifications (Meta Cloud API)
WHATSAPP_PROVIDER=mock
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
META_WHATSAPP_ACCESS_TOKEN=your_system_user_access_token
META_WHATSAPP_TEMPLATE_NAME=order_notification
WHATSAPP_RECEIVER_NUMBER=919999999999

