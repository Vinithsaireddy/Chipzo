PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_BUCKET_NAME=your_r2_bucket_name
CLOUDFLARE_PUBLIC_URL=https://pub-xxxx.r2.dev

# Equivalent R2_* aliases also work:
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=your_r2_bucket_name
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ─── Borzo Delivery ────────────────────────────────────────────────────────────
# Delivery provider — only Borzo is supported
DELIVERY_PROVIDER=borzo
# Get your API token from Borzo Business dashboard → Personal Cabinet → Integration
BORZO_API_KEY=your_borzo_api_token
# Use the sandbox URL for testing; replace with production URL when ready
BORZO_BASE_URL=https://robotapitest-in.borzodelivery.com/api/business/1.8
# Production: https://robot-in.borzodelivery.com/api/business/1.8
BORZO_PICKUP_ADDRESS=KR Road, VV Puram, Bangalore
BORZO_PICKUP_PHONE=+918022421739
BORZO_PICKUP_NAME=Chipzo Store

CLIENT_URL=http://localhost:3000

# Resend Email (Transactional Emails)
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=support@shopchipzo.com

# WhatsApp Notifications (Meta Cloud API)
WHATSAPP_PROVIDER=mock
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
META_WHATSAPP_ACCESS_TOKEN=your_system_user_access_token
META_WHATSAPP_TEMPLATE_NAME=order_notification
WHATSAPP_RECEIVER_NUMBER=919999999999

# Borzo Webhook Secret (set this to any secure value, then append it as
# ?token=<value> to your Borzo Callback URL in the Borzo Business dashboard)
BORZO_WEBHOOK_SECRET=your_borzo_webhook_secret_here
